<?xml version="1.0" encoding="UTF-8"?>
<ftzml version="1">
  <pad id="control" opacity="10">
    <row id="row">
      <icon id="app-icon" glyph="app" label="Application" size="20"/>
      <text id="status">Connection</text>
      <switch id="power" action="toggle-connection" label="Connection enabled" state="on" color="#63dfbd"/>
    </row>
  </pad>
</ftzml>
