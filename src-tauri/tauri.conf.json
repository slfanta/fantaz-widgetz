{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fantaz Widgetz",
  "version": "0.5.0",
  "identifier": "local.fantaz.widgetz.demo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5188",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Fantaz Widgetz \u00b7 demo",
        "width": 360,
        "height": 224,
        "minWidth": 320,
        "minHeight": 224,
        "resizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; object-src 'none'; base-uri 'none'"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": false
  }
}
